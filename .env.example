# Tax990 Go SDK — environment variables
# Copy this file to .env and fill in your credentials.

# Required: OAuth credentials from the Tax990 developer portal.
TAX990_CLIENT_ID=your-client-id
TAX990_CLIENT_SECRET=your-client-secret
TAX990_USER_TOKEN=your-user-token

# Optional: override the default API and OAuth URLs.
# TAX990_BASE_URL=https://api.tax990.com
# TAX990_OAUTH_URL=https://oauth.tax990.com

# Used by the check_filing_status and list_organizations examples.
TAX990_SUBMISSION_ID=
TAX990_BUSINESS_ID=

# Used by the handle_webhook example.
TAX990_WEBHOOK_SECRET=
